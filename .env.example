# Copy this file to .env and fill in the values you need.
# Only the section matching your chosen LLM_PROVIDER actually needs an API key.

# ---------------------------------------------------------------------------
# LLM provider selection: anthropic | openai | local
# "local" routes to a self-hosted vLLM server (see docker-compose.yml,
# profile "local-llm") -- no API key needed for that path.
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic

# --- Anthropic Claude (cloud) ------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI (cloud) -----------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Local vLLM (OpenAI-compatible server) ------------------------------------
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# ---------------------------------------------------------------------------
# Prompt engineering / generation defaults (overridable per-request on /chat)
# ---------------------------------------------------------------------------
TEMPERATURE=0.7
TOP_P=1.0
MAX_TOKENS=1500
MAX_TOOL_ITERATIONS=5

# ---------------------------------------------------------------------------
# RAG pipeline
# ---------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge_base
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
